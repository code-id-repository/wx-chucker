{
  "name": "wx-chucker",
  "version": "1.0.5",
  "description": "In-App Network & Native Bridge Inspector for WeChat Mini-Programs (Chucker for WeChat / TCMPP)",
  "main": "miniprogram_dist/chucker.js",
  "miniprogram": "miniprogram_dist",
  "types": "miniprogram_dist/index.d.ts",
  "bin": {
    "wx-chucker": "scripts/postinstall.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node tests/run_all.js",
    "test:dist": "TARGET_DIR=./miniprogram_dist node tests/run_all.js",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm test && npm run build && npm run test:dist"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "chucker",
    "network-inspector",
    "devtools",
    "tcmpp",
    "curl",
    "interceptor",
    "http",
    "native-bridge"
  ],
  "files": [
    "miniprogram_dist",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "author": "Ryan Agung Samudra <ryansamudra67@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-id-repository/wx-chucker.git"
  },
  "bugs": {
    "url": "https://github.com/code-id-repository/wx-chucker/issues"
  }
}